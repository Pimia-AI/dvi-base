# El .env del módulo en el servidor del integrador, el que lee deploy/compose.server.yaml. Se genera en el servidor
# (0640 root:dvi-executor) a partir de este ejemplo y nunca se sube a git.

# Contraseñas de PostgreSQL: aleatorias y largas (por ejemplo, `openssl rand -hex 32`), una distinta cada una.
DVI_POSTGRES_PASSWORD=
DVI_OWNER_PASSWORD=
DVI_RUNTIME_PASSWORD=

# La instancia de Pimia ERP contra la que valida los tokens de módulo: su origen (https://<instancia>.<dominio>) y su
# slug. Modo de una sola instancia: la empresa de desarrollo de la vertical.
PIMIA_BASE_URL=
PIMIA_TENANT_ID=

# Los anfitriones que pueden embeber las pantallas del módulo: una LISTA EXACTA de orígenes, separados por comas, sin
# barra final (docs/contrato-embebido.md de dvi-base, §9). De aquí salen el `frame-ancestors` de las pantallas y la lista
# con la que el kit acepta `pimia_host`. Van:
#   - el panel de Pimia del entorno (en el entorno de desarrollo de Pimia, https://panel.taskai.work);
#   - y, cuando exista, la app del producto del integrador (https://app.<dominio>), separada por una coma.
# El patrón https://{tenant}.<dominio> está desaconsejado: el anfitrión ya no es la aplicación de cada instancia.
PIMIA_HOST_ORIGINS=https://panel.taskai.work

# El puerto de 127.0.0.1 al que apunta el proxy https del servidor.
MODULE_PORT=
