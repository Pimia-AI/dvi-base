# El .env del módulo de ejemplo en un servidor, con el deploy/compose.server.yaml de la plantilla (template/deploy). En
# local no hace falta: `npm run up` usa compose.yaml, con el doble de Pimia y el anfitrión de desarrollo
# (PIMIA_HOST_ORIGINS=http://127.0.0.1:7161). Se genera en el servidor (0640 root:dvi-executor) a partir de este ejemplo
# y nunca se sube a git.

# Contraseñas de PostgreSQL: aleatorias y largas (por ejemplo, `openssl rand -hex 32`), una distinta cada una.
DVI_POSTGRES_PASSWORD=
DVI_OWNER_PASSWORD=
DVI_RUNTIME_PASSWORD=

# A qué instancias de Pimia ERP sirve el módulo (packages/module/src/config.ts de dvi-base). Dos modos:
#   - toda la vertical (el de la guía del SaaS): el patrón con {tenant} literal en el subdominio. La instancia la dice
#     cada petición y los datos se reparten por negocio y empresa; PIMIA_TENANT_ID se deja vacía.
#   - una sola instancia: su origen fijo (https://<instancia>.taskai.work) y su slug en PIMIA_TENANT_ID.
PIMIA_BASE_URL=https://{tenant}.taskai.work
PIMIA_TENANT_ID=

# Los anfitriones que pueden embeber las pantallas del módulo: una LISTA EXACTA de orígenes, separados por comas, sin
# barra final (docs/contrato-embebido.md de dvi-base, §9). De aquí salen el `frame-ancestors` de las pantallas y la lista
# con la que el kit acepta `pimia_host`. Van:
#   - el panel de Pimia del entorno (en el entorno de desarrollo de Pimia, https://panel.taskai.work);
#   - y, cuando exista, el producto del integrador, en su dominio (https://<producto>), separado por una coma.
# El patrón https://{tenant}.<dominio> está desaconsejado: el anfitrión ya no es la aplicación de cada instancia.
PIMIA_HOST_ORIGINS=https://panel.taskai.work

# El puerto de 127.0.0.1 al que apunta el proxy https del servidor.
MODULE_PORT=
